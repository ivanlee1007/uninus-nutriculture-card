  "x-services": {
    "get_quality_v1": {
      "request": "read_request",
      "response": "dto",
      "supports_response": "ONLY"
    },
    "save_quality_policy_v1": {
      "request": "write_request",
      "response": "dto",
      "supports_response": "OPTIONAL"
    }
  },
  "x-semantic-rules": [
    "Reject Python bool as integer; finite numbers only; reject unknown/null fields except explicit nullable ones.",
    "reported requires attribute=null; sequence/timestamp require nonempty attribute.",
    "enabled requires all source report_contract_confirmed=true and control_contract_version=5.",
    "A completed cycle alone cannot grant; see CONTRACT_PROPOSAL closure and candidate rules.",
    "Policy Save increments revision even for same content; rejected CAS performs no mutation.",
    "Error codes: unauthorized,entry_not_loaded,settings_schema_mismatch,quality_conflict,invalid_quality_policy. quality_conflict covers any of the three expected revision mismatches.",
    "All expiry decisions backend monotonic; expires_at is display only."
  ]
}