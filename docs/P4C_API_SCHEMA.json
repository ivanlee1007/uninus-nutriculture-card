          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "config_entry_id",
        "epoch",
        "revision",
        "policy",
        "availability",
        "error",
        "catalog",
        "deliveries"
      ],
      "additionalProperties": false
    },
    "StoreDocument": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "config_entry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policy": {
          "$ref": "#/$defs/NotificationPolicy"
        }
      },
      "required": [
