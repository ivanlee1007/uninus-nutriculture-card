          "const": "uninus_nutriculture/notification_v1/ack"
        },
        "config_entry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}:[1-9][0-9]{0,15}$"
        }
      },
      "required": [
        "id",
        "type",
        "config_entry_id",
        "expected_epoch",
        "event_id"
      ],
      "additionalProperties": false
    },
    "NotificationReconcileRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "uninus_nutriculture/notification_v1/reconcile"
        },
        "config_entry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_epoch": {
          "type": "string",
