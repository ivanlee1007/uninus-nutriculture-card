  "x-contract": {
    "status": "FROZEN_INTEGRATED_CANDIDATE_NOT_YET_REVIEW_APPROVED",
    "result_service": {
      "name": "uninus_nutriculture.get_result_v1",
      "response": "ONLY",
      "input": "GetResultRequest",
      "output": "ResultDTO"
    },
    "result_event": "uninus_nutriculture_result_v1",
    "ws_response": "native WS result envelope result=NotificationDTO; id is transport request id",
    "policy_input_to_stored": "server resolves target_entity_id into identity-bound target_binding; never accepts client binding",
    "defaults": {
      "enabled": false,
      "provider": null,
      "target_binding": null,
      "events": [],
      "cooldown_seconds": 300
    },
    "cross_field": [
      "enabled implies provider non-null and events nonempty",
      "notify_entity iff target_binding non-null; null or persistent_notification provider implies target_binding null",
      "PolicyInput applies equivalent target_entity_id predicates",
      "Run terminal iff closure confirmed and finished_at non-null; nonterminal finished_at null",
      "current_run nonterminal only; last_result terminal only; all nested run epochs equal enclosing epoch",
      "event_id equals epoch:sequence; sequence integer bounded (regex alone not sufficient)",
      "Event.run null only for alarm outside run; accepted event run.state accepted; terminal events match run.state",
      "unsupported: current_run,last_result,latest_event null",
      "delivery event IDs belong to same entry+epoch, unknown ACK rejected",
      "all integer fields reject bool,float,string before coercion",
