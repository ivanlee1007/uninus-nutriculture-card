        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policy": {
          "$ref": "#/$defs/PolicyInput"
        }
      },
      "required": [
        "id",
        "type",
        "config_entry_id",
        "expected_epoch",
        "expected_revision",
